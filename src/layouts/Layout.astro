---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
}

const {
	title = 'GRIZZLY GEAR - 動物を軸に世界観を紡ぐレザーブランド',
	description = 'GRIZZLY GEAR - 動物を軸に多様な要素を掛け合わせることで世界観を構築するレザーブランド。機構や概念、色彩といった異なる要素を取り入れながら、それぞれのシリーズは動物の持つ象徴性と別のテーマを交差させて形づくられています。革財布、キーケース、カードケースなど、こだわりの革製品を手作りで制作しています。',
	canonical = 'https://grizzlygear-site.vercel.app/',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="google-site-verification" content="4ySpUkp91BdIjH1M5wsarthreHSKMGcobpNej4xlj74" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- 検索エンジン向けメタタグ -->
		<meta name="description" content={description} />
		<meta name="keywords" content="GRIZZLY GEAR,グリズリーギア,レザークラフト,革財布,キーケース,カードケース,ハンドメイド,革製品,歯車,メカニカル,スチームパンク,SHEEP SLEEP,シープスリープ" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		
		<!-- OGP設定 -->
 		<meta property="og:title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content="/images/Type-SCW/main.jpg" />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="GRIZZLY GEAR" />
		
		<!-- Twitter Card設定 -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="/images/Type-SCW/main.jpg" />
		<!-- Google が利用する構造化データ向けの image 指定 -->
		<meta itemprop="image" content="/images/Type-SCW/main.jpg" />

		<!-- Site identity for search engines (JSON-LD) -->
		<script type="application/ld+json">
		[
		  {
		    "@context": "https://schema.org",
		    "@type": "Organization",
		    "name": "GRIZZLY GEAR",
		    "url": "https://grizzlygear-site.vercel.app",
		    "logo": "https://grizzlygear-site.vercel.app/images/Type-SCW/main.jpg"
		  },
		  {
		    "@context": "https://schema.org",
		    "@type": "WebSite",
		    "name": "GRIZZLY GEAR",
		    "url": "https://grizzlygear-site.vercel.app",
		    "publisher": {
		      "@type": "Organization",
		      "name": "GRIZZLY GEAR",
		      "logo": {
		        "@type": "ImageObject",
		        "url": "https://grizzlygear-site.vercel.app/images/Type-SCW/main.jpg"
		      }
		    }
		  }
		]
		</script>
		<meta name="application-name" content="GRIZZLY GEAR" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		min-height: 100vh;
	}

</style>
